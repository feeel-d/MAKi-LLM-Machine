VITE_API_BASE_URL=https://your-funnel-url.ts.net
GATEWAY_PORT=3001
# 기본 127.0.0.1 — 같은 Tailnet에서 다른 기기가 100.x.x.x:3001 로 붙게 하려면 0.0.0.0
GATEWAY_HOST=127.0.0.1
LLAMA_SERVER_URL=http://127.0.0.1:8081
LLAMA_API_KEY=
# GitHub Pages·로컬 Vite. 외부 도메인은 쉼표로 추가. 전체 허용은 * (브라우저 Origin 그대로 반환)
# Tailscale Funnel(https://*.ts.net) 출처는 게이트웨이가 자동 허용(별도 나열 불필요)
ALLOWED_ORIGINS=https://feeel-d.github.io,http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_BURST=4
RATE_LIMIT_BURST_WINDOW_MS=10000
RATE_LIMIT_MINUTE=12
QUEUE_CAPACITY=2
QUEUE_MAX_PENDING=8
REQUEST_TIMEOUT_MS=300000
MAX_BODY_BYTES=65536
# 로컬 MAKi 서버와 맞추는 기본값. 운영에서는 반드시 별도 비밀값으로 교체
SERVICE_API_KEY=test-service-key
CONTENT_RETRY_COUNT=1
IMAGE_FETCH_TIMEOUT_MS=15000
MAX_IMAGE_BYTES=8388608
ALLOWED_IMAGE_MIME=image/jpeg,image/png,image/webp,image/gif
MODELS_DIR=$HOME/models
GEMMA26_MODEL_PATH=$HOME/models/gemma4-26b.gguf
GEMMAE4_MODEL_PATH=$HOME/models/gemma4-e4b.gguf
# E4B 비전(mmproj). bartowski 레포의 f16 투영기 — 이미지 API에 필수
GEMMAE4_MMPROJ_PATH=$HOME/models/mmproj-google_gemma-4-E4B-it-f16.gguf
# llama 라우터(run-llama-router.sh) — E4B 이미지는 ubatch가 너무 작으면 llama.cpp assert
ROUTER_BATCH=1024
ROUTER_UBATCH=1024
ROUTER_MMPROJ_OFFLOAD=0
GEMMAE4_N_GPU_LAYERS=0
GEMMA26_CTX=4096
# CoT·이미지 본문 생성 KV 여유 (RAM 부족 시 4096·2048 등으로 낮춤)
GEMMAE4_CTX=8192

# body-from-image (약 3줄 요약) max_tokens — 긴 글 시 env로 상향
# CONTENT_BODY_MAX_TOKENS_SHORT=320
# CONTENT_BODY_MAX_TOKENS_MEDIUM=512
# CONTENT_BODY_MAX_TOKENS_LONG=768
